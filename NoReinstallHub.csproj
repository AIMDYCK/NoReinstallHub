<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Version.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <RootNamespace>NoReinstallHub</RootNamespace>
    <AssemblyName>NoReinstallHub</AssemblyName>
    <ProjectName>NoReinstallHub</ProjectName>
    <!-- Assembly metadata (shown in .exe Properties > Details) -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 10pt</ApplicationDefaultFont>
    <Company>Aimdick</Company>
    <Product>NoReinstallHub</Product>
    <Description>Local NTFS folder links without moving your files</Description>
    <AssemblyTitle>NoReinstallHub</AssemblyTitle>
    <AssemblyDescription>Local NTFS folder links without moving your files</AssemblyDescription>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>
</Project>
