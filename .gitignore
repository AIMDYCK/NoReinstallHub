# ============================================================================
# NoReinstallHub - .gitignore
# Stack : C# / .NET 8 / Windows Forms (WinExe, net8.0-windows)
# Layout: single project desktop app -> NoReinstallHub.csproj
#
# Everything required to build, run, test and document the app stays under
# version control (source, .csproj, app.manifest, app_icon.ico, README, docs).
# Only machine-specific, generated, local or secret-bearing files are ignored.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. IDE / editor state (user- and machine-specific)
# ---------------------------------------------------------------------------
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
*.suo
*.user
*.userosscache
*.userprefs
*.sln.docstates
*.VC.db
*.VC.VC.opendb

# ---------------------------------------------------------------------------
# 2. Build output (regenerated by `dotnet build` / `dotnet restore`)
#    Contains compiled assemblies, caches and ABSOLUTE local paths.
# ---------------------------------------------------------------------------
**/[Bb]in/
**/[Oo]bj/

# ---------------------------------------------------------------------------
# 3. Test and coverage output
# ---------------------------------------------------------------------------
TestResults/
**/TestResults/
*.trx
*.coverage
*.coveragexml
coverage/

# ---------------------------------------------------------------------------
# 4. Publish / distribution output (regenerated by `dotnet publish`)
#    These folders only hold compiled binaries, runtime DLLs and .pdb files.
#    Publish them through GitHub Releases. If a build must really live inside
#    the repository, remove the matching line or use `git add -f <file>`.
# ---------------------------------------------------------------------------
publish/
publish_*/
**/publish/
**/publish_*/
# Explicit paths used by the release workflow (already covered by the rules above)
publish/light-*/
publish/standalone-*/
publish/release-assets/

# ---------------------------------------------------------------------------
# 5. Logs, temporary files and local caches
# ---------------------------------------------------------------------------
*.log
*.log.*
logs/
*.tmp
*.temp
*.cache
*.pid
artifacts/
*.bak
*.orig
*.rej
*.old
*~
*.swp

# OS leftovers
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---------------------------------------------------------------------------
# 6. NuGet packages (restored on demand, never edited by hand)
# ---------------------------------------------------------------------------
*.nupkg
*.snupkg
.nuget/

# ---------------------------------------------------------------------------
# 7. Local configuration and secrets - NEVER commit real values
#    NOTE: *.json / *.xml / *.config / *.dll are NOT ignored globally.
#    Several of them may be required to build, run or distribute the app.
# ---------------------------------------------------------------------------
# .env files (keep templates/examples so contributors know what is required)
.env
.env.*
!.env.example
!.env.template
!.env.sample

# Local-only configuration overrides
secrets.json
credentials.json
token.json
settings.local.json
*.local.json
appsettings.Local.json
appsettings.*.Local.json

# Certificates and cryptographic keys
*.pfx
*.p12
*.pem
*.key
*.jks
*.keystore
# NOTE: *.snk (strong-name key) is intentionally NOT ignored: it can be
# required to build the signed assembly.

# ---------------------------------------------------------------------------
# 8. Local data / databases created at runtime
# ---------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sdf
*.mdf
*.ldf

# ---------------------------------------------------------------------------
# 9. Intentionally KEPT in version control (do not add broad rules above)
# ---------------------------------------------------------------------------
#   Program.cs, MainForm.cs, MainForm.Designer.cs, InstructionsForm.cs
#   NoReinstallHub.csproj, app.manifest, app_icon.ico
#   README.md and docs/screenshot.png (referenced by README.md)
