# NoReinstallHub — local, generated, machine-specific, and sensitive files

# IDE and editor state. Only share extension recommendations.
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.user
*.userosscache
*.userprefs
*.sln.docstates
*.VC.db
*.VC.VC.opendb

# Build, restore, publish, test, and coverage output.
**/[Bb]in/
**/[Oo]bj/
**/[Pp]ublish/
**/[Pp]ublish_*/
**/TestResults/
TestResults/
coverage/
*.trx
*.coverage
*.coveragexml
artifacts/

# Compiled binaries, symbols, and local release packages. Keep source and icons.
*.exe
*.dll
*.pdb
*.deps.json
*.runtimeconfig.json
*.winmd
*.msix
*.msixbundle
*.msixupload
*.appx
*.appxbundle
*.appxupload
*.appinstaller
NoReinstallHub-*.zip
packaging/output/

# NuGet caches and downloaded packages.
.nuget/
*.nupkg
*.snupkg

# Environment variables and local configuration. Explicit examples may be shared.
.env
.env.*
!.env.example
!.env.template
!.env.sample
.envrc
**/secrets.json
**/*secret*.json
**/credentials.json
**/*credential*.json
**/token.json
**/*token*.json
**/*.local.*
**/*.user.*
**/preferences.json
**/settings.local.json
**/local.settings.json
**/appsettings*.json
!**/appsettings.example.json
!**/appsettings.template.json

# Signing credentials and private keys (including strong-name keys).
*.pfx
*.p12
*.pem
*.key
*.snk
*.jks
*.keystore
*.ppk
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# Local agent, cloud credential, and decision/report state.
/.aws/
/.codex/
/.agents/
/DECISIONES.md
/INFORME_MEJORAS.md

# Logs, caches, temporary files, backups, and crash dumps.
*.log
*.log.*
logs/
*.tmp
*.temp
*.cache
*.pid
*.bak
*.orig
*.rej
*.old
*.dmp
*.dump
core
core.*
*~
*.swp

# Local databases and runtime data.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sdf
*.mdf
*.ldf

# Operating-system metadata.
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
